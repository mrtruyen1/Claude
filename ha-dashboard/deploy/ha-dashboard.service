[Unit]
Description=ha-dashboard (Next.js) - Home Assistant custom dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ha-dashboard
Group=ha-dashboard
WorkingDirectory=/opt/ha-dashboard
EnvironmentFile=/opt/ha-dashboard/.env
Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
ExecStart=/usr/bin/node /opt/ha-dashboard/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ha-dashboard

[Install]
WantedBy=multi-user.target
